NODE_ENV=development
PORT=4181
DATA_DIR=.data
# Optional: use this when a host gives you one exact writable file path.
STATE_FILE=

# Admin backend controlled access
ADMIN_ACCESS_KEY=
ADMIN_TOKEN_SECRET=
ADMIN_TOKEN_TTL_MS=28800000
CONTRIBUTOR_TOKEN_SECRET=
CONTRIBUTOR_TOKEN_TTL_MS=604800000
BUYER_TOKEN_SECRET=
BUYER_TOKEN_TTL_MS=604800000
OTP_TTL_MS=600000

# Global subscription charging
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# Contributor payouts by country
NG_PAYSTACK_SECRET=
GH_FLW_SECRET=
KE_MPESA_SECRET=
ZA_OZOW_SECRET=
RW_FLW_SECRET=

# SMS OTP providers by country
TERMII_API_KEY=
HUBTEL_API_KEY=
AFRICASTALKING_API_KEY=
CLICKATELL_API_KEY=

# Verification and image processing
KYC_PROVIDER_API_KEY=
FACE_MATCH_API_KEY=
AI_IMAGE_ENHANCEMENT_API_KEY=
CONTENT_MODERATION_API_KEY=

# Storage and email
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
CDN_HOSTNAME=
EMAIL_PROVIDER_API_KEY=

# AWS ECS/Fargate deployment helper variables
AWS_REGION=us-east-1
APP_NAME=vuekumi
STACK_NAME=vuekumi-prod
ECR_REPO=vuekumi
IMAGE_TAG=
VPC_ID=
PUBLIC_SUBNET_IDS=
DESIRED_COUNT=1
CPU=512
MEMORY=1024
CERTIFICATE_ARN=
